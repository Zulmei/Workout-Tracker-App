# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore.

.gcloudignore
.git/
.gitignore

# Python virtual environments
.venv/
env/
venv/

# Compiled Python files and caches
__pycache__/
*.py[cod]
*$py.class

# Build and test cache
.pytest_cache/
.cache/
coverage/
*.log

# Local environment config
.env
setup.cfg

# OS junk
.DS_Store
Thumbs.db
